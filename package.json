{
  "name": "@venkatasudhalabs/codex-report",
  "version": "0.0.1-dev",
  "description": "Local Codex usage accounting, readable turn reports and a live dashboard",
  "packageManager": "pnpm@10.11.0",
  "author": {
    "name": "kanakamedala-rajesh",
    "url": "https://github.com/kanakamedala-rajesh"
  },
  "homepage": "https://github.com/kanakamedala-rajesh/codex-report#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanakamedala-rajesh/codex-report.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/kanakamedala-rajesh/codex-report/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "token-usage",
    "usage-analytics",
    "sqlite",
    "dashboard",
    "codex-cli",
    "local-first"
  ],
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "codex-report": "dist/cli.js"
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "files": [
    "dist",
    "public",
    "data",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/SECURITY.md",
    "runtime",
    "docs/TEST-REPORT.md",
    "docs/ARCHITECTURE.md",
    "docs/SESSION-SETTINGS-PATCH.md",
    "docs/SOURCES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "typecheck": "pnpm run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm run build && node tools/test-runner.cjs",
    "test:coverage": "pnpm run build && node tools/test-runner.cjs --coverage",
    "test:package": "pnpm run build && node tools/package-smoke.cjs",
    "check:package": "node tools/check-package.cjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm test && pnpm run check:package",
    "verify": "pnpm run check && pnpm run test:package",
    "audit:dependencies": "pnpm audit --prod --audit-level=high",
    "test:browser": "pnpm run build && node tools/browser-smoke.cjs && node tools/appearance-browser.cjs",
    "test:appearance": "pnpm run build && node tools/appearance-browser.cjs",
    "pack:local": "pnpm run build && pnpm run check:package && node tools/pack.cjs",
    "browser:install": "playwright-core install chromium"
  },
  "optionalDependencies": {
    "libsql": "0.5.29"
  },
  "devDependencies": {
    "@eslint/js": "9.25.1",
    "@types/node": "22.19.7",
    "eslint": "9.25.1",
    "globals": "16.1.0",
    "prettier": "3.9.9",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.1",
    "playwright-core": "1.56.1"
  }
}
